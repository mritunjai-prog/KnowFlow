# Neon example. sslmode is required by Neon. Do not commit a real URL.
DATABASE_URL=postgresql+psycopg://user:password@ep-example.neon.tech/knowflow?sslmode=require
KNOWFLOW_ALLOWED_ORIGINS=http://localhost:5173,https://your-site.netlify.app
KNOWFLOW_COOKIE_SECURE=true
# Comma-separated verified addresses promoted to Admin. Never a registration field.
KNOWFLOW_ADMIN_EMAILS=
KNOWFLOW_AUTH_RATE_LIMIT=8
